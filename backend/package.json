{
  "name": "younovate-lms-backend",
  "version": "3.0.0",
  "description": "Younovate LMS — Complete REST API with LiveKit, Socket.io, S3, SMTP",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/utils/seed.js",
    "yiep": "node src/data/yiepCurriculum.js",
    "setup": "npm run seed && npm run yiep && npm run start",
    "seed:force": "node src/seed/seedYIEP.js --force",
    "seedsubjects": "node src/scripts/backfillSubjectContent.js --code=YIEP --dry",
    "seedin": "node src/scripts/seedYiep.js --force",
    "yblp": "node src/data/yblpCurriculum.js",
    "yblpseed": "node src/seed/seedYblp.js --force",
    "yblprun": "node src/scripts/seedYblp.js",
    "seedtrainees": "node src/scripts/seedTrainees.js",
    "seedtrainees:force": "node src/scripts/seedTrainees.js --force"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1121.0",
    "@livekit/components-react": "^2.9.21",
    "@livekit/components-styles": "^1.2.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.19.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.0",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.0",
    "livekit-client": "^2.19.2",
    "livekit-server-sdk": "^2.15.4",
    "mongoose": "^8.23.1",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.20.2",
    "resend": "^6.22.0",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "axios": "^1.18.1",
    "nodemon": "^3.1.0"
  }
}
