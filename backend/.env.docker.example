# Copy relevant values into .env for local Docker LiveKit recording.
# Requires: docker compose -f docker-compose.livekit-dev.yml up -d

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
# Match api_secret in livekit.yaml / egress.yaml at repo root
LIVEKIT_API_SECRET=your-devkey-secret-from-livekit-yaml
PUBLIC_API_URL=http://localhost:8080
USE_S3_RECORDING=false
EGRESS_CONTAINER=lms-livekit-egress-1
